    def scenario_adaptive_daemon_cadence(self, result: ScenarioResult) -> None:
        short_dir = self.run_dir / "adaptive-short-term"
        weekly_dir = self.run_dir / "adaptive-weekly-only"
        common = [
            "--interval-seconds",
            "4",
            "--near-interval-seconds",
            "1",
            "--critical-interval-seconds",
            "1",
        ]

        def log_lines(state_dir: Path) -> List[str]:
            log_path = state_dir / "quota-sentry.log"
            if not log_path.exists():
                return []
            return [line for line in log_path.read_text().splitlines() if line.strip()]

        try:
            self.run(
                result,
                [str(QUOTA_SENTRY), "start", "--state-dir", str(short_dir), *common],
                env=self.env("app-server-open"),
            )
            self.run(
                result,
                [str(QUOTA_SENTRY), "start", "--state-dir", str(weekly_dir), *common],
                env=self.env("app-server-weekly-only-open"),
            )

            deadline = time.monotonic() + 3
            while time.monotonic() < deadline:
                if log_lines(short_dir) and log_lines(weekly_dir):
                    break
                time.sleep(0.05)
            if not log_lines(short_dir) or not log_lines(weekly_dir):
                raise AutonomousTestError("adaptive cadence daemons did not publish initial state")

            time.sleep(1.4)
            short_count = len(log_lines(short_dir))
            weekly_count = len(log_lines(weekly_dir))
            if short_count < 2:
                raise AutonomousTestError(
                    f"short-term daemon did not use tighter cadence: {short_count} polls"
                )
            if weekly_count != 1:
                raise AutonomousTestError(
                    f"weekly-only daemon unexpectedly used short-term cadence: {weekly_count} polls"
                )

            (weekly_dir / "refresh.request").write_text("refresh\n")
            deadline = time.monotonic() + 2
            while time.monotonic() < deadline and len(log_lines(weekly_dir)) < 2:
                time.sleep(0.05)
            if len(log_lines(weekly_dir)) < 2:
                raise AutonomousTestError("refresh request did not wake weekly-only daemon")
        finally:
            for state_dir, mode in (
                (short_dir, "app-server-open"),
                (weekly_dir, "app-server-weekly-only-open"),
            ):
                self.run(
                    result,
                    [str(QUOTA_SENTRY), "stop", "--state-dir", str(state_dir)],
                    env=self.env(mode),
                )

        result.notes.append(
            "Short-term state used the tighter cadence, weekly-only state retained the base "
            "cadence, and a coalesced refresh request woke the weekly daemon early."
        )

    def scenario_claude_usage_poll(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "claude-poll"
        self.claude_server.set_json(claude_body(41, 24))
        state = self.claude_poll(result, state_dir)
        if (state.get("status"), state.get("provider"), state.get("source")) != (
                "open", "claude", "claude-usage-api"):
            raise AutonomousTestError(f"unexpected Claude state: {state}")
        kinds = {window.get("limitId"): window.get("windowMinutes")
                 for window in state.get("windows", [])}
        if kinds != {"five_hour": 300, "seven_day": 10080}:
            raise AutonomousTestError(f"Claude windows were not classified by name: {kinds}")
        request = self.claude_server.last_request()
        if request.get("authorization") != f"Bearer {CLAUDE_HARNESS_TOKEN}":
            raise AutonomousTestError("usage request did not carry the stored Claude login")
        if request.get("beta") != "oauth-2025-04-20":
            raise AutonomousTestError(f"usage request beta header was {request.get('beta')!r}")
        result.notes.append("Poll read 5h/weekly windows from the loopback endpoint with the fake stored login.")

    def scenario_claude_daemon_releases_parked_hook(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "claude-daemon-park"
        env = self.claude_env()
        self.claude_server.set_json(claude_body(95, 24))
        self.run(result, [str(QUOTA_SENTRY), "start", "--provider", "claude",
                          "--state-dir", str(state_dir), "--interval-seconds", "1",
                          "--near-interval-seconds", "1", "--critical-interval-seconds", "1",
                          "--min-poll-spacing-seconds", "1"],
                 env=env)
        guard = None
        try:
            self.wait_for_status(state_dir, "blocked")
            guard = self.claude_hook_guard(state_dir, env)
            time.sleep(2.5)
            if guard.poll() is not None:
                raise AutonomousTestError("hook released while the 5h window was at 95%")
            self.claude_server.set_reply(500, {}, b"")
            time.sleep(2.5)
            if guard.poll() is not None:
                raise AutonomousTestError("hook released on a source outage during a confirmed block")
            requests_while_parked = self.claude_server.request_count()
            self.claude_server.set_json(claude_body(0, 24, five_reset_seconds=None))
            stdout, stderr = guard.communicate(timeout=20)
            if guard.returncode != 0:
                raise AutonomousTestError(f"released hook exited {guard.returncode}")
            if stdout.strip() or stderr.strip():
                raise AutonomousTestError(f"hook was not quiet: {stdout!r} {stderr!r}")
            state = self.state(state_dir)
            if state.get("status") != "open":
                raise AutonomousTestError(f"daemon did not clear the block: {state}")
            result.notes.append(
                f"Hook stayed parked through 95% and an HTTP 500; daemon made "
                f"{requests_while_parked} endpoint reads; a fresh 0% reading released it quietly.")
        finally:
            if guard is not None and guard.poll() is None:
                guard.kill()
                guard.wait(timeout=5)
            self.run(result, [str(QUOTA_SENTRY), "stop", "--provider", "claude",
                              "--state-dir", str(state_dir)], env=env)

    def scenario_claude_failures_keep_block_and_never_deny(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "claude-failures-blocked"
        self.claude_server.set_json(claude_body(95, 24))
        if self.claude_poll(result, state_dir).get("status") != "blocked":
            raise AutonomousTestError("95% 5h reading did not block")
        failures = [
            ("HTTP 500", lambda: self.claude_server.set_reply(500, {}, b"")),
            ("HTTP 401", lambda: self.claude_server.set_reply(401, {}, b'{"error":"x"}')),
            ("unreadable JSON", lambda: self.claude_server.set_reply(
                200, {"Content-Type": "application/json"}, b"not json")),
        ]
        for label, apply in failures:
            apply()
            state = self.claude_poll(result, state_dir)
            if state.get("status") != "blocked" or state.get("sourceStatus") != "unknown":
                raise AutonomousTestError(f"{label} changed a confirmed block: {state}")
        self.claude_server.set_json(claude_body(20, 24))
        state = self.claude_poll(result, state_dir, login="missing")
        if state.get("status") != "blocked":
            raise AutonomousTestError(f"missing login released a confirmed block: {state}")

        open_dir = self.run_dir / "claude-failures-unlatched"
        self.claude_server.set_reply(500, {}, b"")
        if self.claude_poll(result, open_dir).get("status") != "unknown":
            raise AutonomousTestError("source outage without a block was not unknown")
        started = time.monotonic()
        guard = self.claude_hook_guard(open_dir, self.claude_env())
        stdout, stderr = guard.communicate(timeout=10)
        if guard.returncode != 0 or stdout.strip() or stderr.strip():
            raise AutonomousTestError(
                f"unlatched outage was denied or noisy: {guard.returncode} {stdout!r} {stderr!r}")
        result.notes.append(
            f"500/401/bad JSON/missing login kept the block; unlatched outage continued in "
            f"{time.monotonic() - started:.2f}s with no output.")

    def scenario_claude_weekly_and_advisory_windows(self, result: ScenarioResult) -> None:
        self.claude_server.set_json(claude_body(10, 99))
        state = self.claude_poll(result, self.run_dir / "claude-weekly")
        if (state.get("status"), state.get("blockedWindow")) != ("blocked", "weekly"):
            raise AutonomousTestError(f"weekly 99% did not hard-block: {state}")
        week_reset = (datetime.now(timezone.utc) + timedelta(days=1)).isoformat()
        self.claude_server.set_json(claude_body(10, 20, extra={
            "seven_day_opus": {"utilization": 100, "resets_at": week_reset}}))
        state = self.claude_poll(result, self.run_dir / "claude-advisory")
        if state.get("status") != "open":
            raise AutonomousTestError(f"model-scoped weekly row blocked all work: {state}")
        result.notes.append("Weekly 99% blocked; a 100% Opus-only weekly row stayed advisory.")

    def scenario_claude_rate_limit_back_off(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "claude-rate-limited"
        self.claude_server.set_reply(429, {"Retry-After": "120"}, b"")
        before = self.claude_server.request_count()
        first = self.claude_poll(result, state_dir)
        second = self.claude_poll(result, state_dir)
        asked = self.claude_server.request_count() - before
        if asked != 1:
            raise AutonomousTestError(f"endpoint was asked {asked} times during a 429 hold")
        if first.get("status") != "unknown" or "rate-limited" not in str(second.get("reason")):
            raise AutonomousTestError(f"429 hold was not reported as unknown: {second}")
        if not (state_dir / "claude-usage.hold").exists():
            raise AutonomousTestError("429 hold file was not written")
        result.notes.append("HTTP 429 recorded a hold; the next poll did not contact the endpoint.")

    def scenario_claude_hook_installer_temp_merge(self, result: ScenarioResult) -> None:
        settings = self.run_dir / "claude-installer" / "settings.json"
        settings.parent.mkdir(parents=True, exist_ok=True)
        original = {
            "env": {"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"},
            "hooks": {"Stop": [{"hooks": [{"type": "command", "command": "notify.sh"}]}]},
        }
        settings.write_text(json.dumps(original, indent=2) + "\n")
        command = [str(QUOTA_SENTRY), "install-hook", "--provider", "claude",
                   "--hooks-path", str(settings), "--script-path", str(QUOTA_SENTRY)]
        self.run(result, command, env=self.env())
        installed = json.loads(settings.read_text())
        if installed.get("env") != original["env"] or installed["hooks"].get("Stop") != original["hooks"]["Stop"]:
            raise AutonomousTestError("installer changed unrelated Claude settings")
        events = {"SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
                  "PostToolBatch", "PreCompact"}
        for event in events:
            hooks = [hook for entry in installed["hooks"].get(event, []) for hook in entry["hooks"]
                     if hook.get("command") == str(QUOTA_SENTRY)]
            if len(hooks) != 1 or hooks[0].get("args", [])[-2:] != ["--provider", "claude"]:
                raise AutonomousTestError(f"{event} hook missing or wrong: {hooks}")
            expected_timeout = 30 if event == "SessionStart" else EXPECTED_BLOCKING_HOOK_TIMEOUT_SECONDS
            if hooks[0].get("timeout") != expected_timeout:
                raise AutonomousTestError(f"{event} timeout was {hooks[0].get('timeout')}")
        first = settings.read_bytes()
        self.run(result, command, env=self.env())
        if settings.read_bytes() != first:
            raise AutonomousTestError("second install was not idempotent")
        if json.loads(Path(str(settings) + ".bak").read_text()) != original:
            raise AutonomousTestError("backup does not match the original settings")
        result.notes.append("Installer merged six Claude hooks, kept other settings, backed up, and is idempotent.")

    def scenario_claude_sign_in_renews_expiring_token(self, result: ScenarioResult) -> None:
        expiring = json.loads(json.dumps(CLAUDE_HARNESS_CREDENTIALS))
        expiring["claudeAiOauth"]["expiresAt"] = int((time.time() - 60) * 1000)
        self.write_claude_login(expiring)
        try:
            self.claude_server.set_json(claude_body(30, 20))
            before = len(self.claude_server.token_requests())
            state = self.claude_poll(result, self.run_dir / "claude-renewal")
            renewals = self.claude_server.token_requests()[before:]
            if state.get("status") != "open":
                raise AutonomousTestError(f"poll after renewal was not open: {state}")
            if len(renewals) != 1 or renewals[0].get("grant_type") != "refresh_token":
                raise AutonomousTestError(f"expected one refresh_token renewal, saw {renewals}")
            saved = json.loads(self.claude_login.read_text())["claudeAiOauth"]
            if saved.get("accessToken") != CLAUDE_HARNESS_RENEWED_TOKEN:
                raise AutonomousTestError("renewed token was not saved")
            if (self.claude_login.stat().st_mode & 0o777) != 0o600:
                raise AutonomousTestError("renewed login file is not private")
            if self.claude_server.last_request().get("authorization") != (
                    f"Bearer {CLAUDE_HARNESS_RENEWED_TOKEN}"):
                raise AutonomousTestError("usage read did not use the renewed token")
            result.notes.append("Expired own sign-in was renewed once, saved 0600, and used for the read.")
        finally:
            self.write_claude_login(CLAUDE_HARNESS_CREDENTIALS)

    def scenario_claude_login_stores_private_sign_in(self, result: ScenarioResult) -> None:
        env = self.claude_env(login="fresh")
        login_path = Path(env["XDG_CONFIG_HOME"]) / "quota-sentry" / "claude-credentials.json"
        before = len(self.claude_server.token_requests())
        process = subprocess.Popen(
            [str(QUOTA_SENTRY), "login", "--provider", "claude"], cwd=ROOT, env=env,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        try:
            url = ""
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline and not url:
                line = process.stdout.readline()
                if not line:
                    break
                if line.startswith("https://claude.com/cai/oauth/authorize?"):
                    url = line.strip()
            if not url:
                raise AutonomousTestError("login did not print a sign-in link")
            from urllib.parse import parse_qs, urlparse
            state = parse_qs(urlparse(url).query)["state"][0]
            stdout, stderr = process.communicate(f"harness-code#{state}\n", timeout=15)
        finally:
            if process.poll() is None:
                process.kill()
                process.wait(timeout=5)
        if process.returncode != 0:
            raise AutonomousTestError(f"login exited {process.returncode}: {stderr!r}")
        exchanges = self.claude_server.token_requests()[before:]
        if len(exchanges) != 1 or exchanges[0].get("grant_type") != "authorization_code" \
                or exchanges[0].get("code") != "harness-code" or not exchanges[0].get("code_verifier"):
            raise AutonomousTestError(f"unexpected code exchange: {exchanges}")
        saved = json.loads(login_path.read_text())["claudeAiOauth"]
        if saved.get("accessToken") != CLAUDE_HARNESS_RENEWED_TOKEN or saved.get("scopes") != ["user:profile"]:
            raise AutonomousTestError(f"login saved the wrong sign-in: {list(saved)}")
        if (login_path.stat().st_mode & 0o777) != 0o600:
            raise AutonomousTestError("login file is not private")
        if CLAUDE_HARNESS_RENEWED_TOKEN in stdout + stderr:
            raise AutonomousTestError("login printed a token")
        result.notes.append("login printed a PKCE link, exchanged the pasted code once, and saved a 0600 file.")

    def scenario_claude_daemon_spaces_reads(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "claude-spacing"
        env = self.claude_env()
        self.claude_server.set_json(claude_body(95, 24))
        self.run(result, [str(QUOTA_SENTRY), "start", "--provider", "claude",
                          "--state-dir", str(state_dir), "--interval-seconds", "1",
                          "--near-interval-seconds", "1", "--critical-interval-seconds", "1",
                          "--min-poll-spacing-seconds", "3"], env=env)
        try:
            self.wait_for_status(state_dir, "blocked")
            first = self.claude_server.request_count()
            deadline = time.monotonic() + 4.5
            while time.monotonic() < deadline:
                (state_dir / "refresh.request").write_text("refresh\n")
                time.sleep(0.2)
            reads = self.claude_server.request_count() - first
            if reads > 2:
                raise AutonomousTestError(f"daemon read the endpoint {reads} times in 4.5s at 3s spacing")
            if reads < 1:
                raise AutonomousTestError("daemon stopped reading the endpoint")
            result.notes.append(f"Constant refresh requests produced {reads} reads in 4.5s at 3s spacing.")
        finally:
            self.run(result, [str(QUOTA_SENTRY), "stop", "--provider", "claude",
                              "--state-dir", str(state_dir)], env=env)

    def scenario_claude_daemon_paces_reads(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "claude-pacing"
        env = self.claude_env()
        refresh = state_dir / "refresh.request"

        def reads_during(seconds: float, *, request_refresh: bool) -> int:
            first = self.claude_server.request_count()
            deadline = time.monotonic() + seconds
            while time.monotonic() < deadline:
                if request_refresh:
                    refresh.write_text("refresh\n")
                time.sleep(0.2)
            return self.claude_server.request_count() - first

        self.claude_server.set_json(claude_body(50, 24))
        self.run(result, [str(QUOTA_SENTRY), "start", "--provider", "claude",
                          "--state-dir", str(state_dir), "--interval-seconds", "4",
                          "--near-interval-seconds", "1", "--critical-interval-seconds", "1",
                          "--min-poll-spacing-seconds", "1"], env=env)
        try:
            self.wait_for_status(state_dir, "open")
            far = reads_during(5, request_refresh=False)
            if far > 2:
                raise AutonomousTestError(f"daemon read {far} times in 5s at 50% with a 4s base interval")
            self.claude_server.set_json(claude_body(99, 24))
            refresh.write_text("refresh\n")
            self.wait_for_status(state_dir, "blocked")
            blocked = reads_during(5, request_refresh=True)
            if blocked > 2:
                raise AutonomousTestError(
                    f"refresh requests drove {blocked} reads in 5s while blocked before the reset")
            if blocked < 1:
                raise AutonomousTestError("daemon stopped reading while blocked")
            self.claude_server.set_json(claude_body(86, 24))
            self.wait_for_status(state_dir, "open")
            near = reads_during(4, request_refresh=False)
            if near < 3:
                raise AutonomousTestError(f"daemon read only {near} times in 4s at 86% with a 1s near interval")
            result.notes.append(
                f"Reads: {far} in 5s at 50%; {blocked} in 5s while blocked before the reset despite "
                f"constant refresh requests; {near} in 4s at 86%.")
        finally:
            self.run(result, [str(QUOTA_SENTRY), "stop", "--provider", "claude",
                              "--state-dir", str(state_dir)], env=env)

    def run_all(self) -> None:
        self.run_scenario("AT-001", "live Codex quota source smoke", self.scenario_live_quota_source_smoke)
