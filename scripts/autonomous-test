            expected_returncode=2,
        )
        result.notes.append(
            "A backend exhaustion signal with no quota windows produced a durable account block."
        )

    def scenario_fresh_unknown_state_fails_closed(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "fresh-unknown-fails-closed"
        env = self.env("app-server-exit-failure")
        self.run(
            result,
            [str(QUOTA_SENTRY), "poll", "--state-dir", str(state_dir)],
            env=env,
        )
        state = self.state(state_dir)
        if state.get("status") != "unknown":
            raise AutonomousTestError(f"expected fresh unknown source state, got: {state}")
        self.run(
            result,
            [
                str(QUOTA_SENTRY),
                "guard",
                "--state-dir",
                str(state_dir),
                "--state-only",
                "--require-fresh-state",
                "--no-notify",
            ],
            env=env,
            expected_returncode=2,
        )
        result.notes.append("A freshly timestamped unknown source state was denied by the hook guard.")

    def scenario_omitted_backend_state_cannot_clear_latch(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "omitted-backend-state"
        self.run(
            result,
            [str(QUOTA_SENTRY), "poll", "--state-dir", str(state_dir)],
            env=self.env("app-server-account-exhausted-no-windows"),
        )
        self.run(
            result,
            [str(QUOTA_SENTRY), "poll", "--state-dir", str(state_dir)],
            env=self.env("app-server-open"),
        )
        omitted_state = self.state(state_dir)
        if omitted_state.get("status") != "blocked":
            raise AutonomousTestError(
                f"omitted backend state cleared a confirmed account latch: {omitted_state}"
            )
        self.run(
            result,
            [str(QUOTA_SENTRY), "poll", "--state-dir", str(state_dir)],
            env=self.env("app-server-explicit-backend-clear"),
        )
        cleared_state = self.state(state_dir)
        if cleared_state.get("status") != "open":
            raise AutonomousTestError(
                f"explicit backend clear did not release account latch: {cleared_state}"
            )
        result.notes.append(
            "Omitted backend state preserved the latch, while an explicit clear released it."
        )

    def scenario_ambiguous_replacement_buckets_fail_closed(self, result: ScenarioResult) -> None:
        state_dir = self.run_dir / "ambiguous-replacement-buckets"
        env = self.env("app-server-ambiguous-replacement-buckets")
        self.run(
            result,
            [str(QUOTA_SENTRY), "poll", "--state-dir", str(state_dir)],
            env=env,
        )
        state = self.state(state_dir)
        if state.get("status") != "unknown":
            raise AutonomousTestError(
                f"ambiguous replacement buckets were accepted as open: {state}"
            )
        self.run(
            result,
            [
                str(QUOTA_SENTRY),
                "guard",
                "--state-dir",
                str(state_dir),
                "--state-only",
                "--require-fresh-state",
                "--no-notify",
            ],
            env=env,
            expected_returncode=2,
        )
        result.notes.append(
            "Multiple renamed buckets without a canonical Codex identity were denied."
        )

    def run_all(self) -> None:
        self.run_scenario("AT-001", "live Codex quota source smoke", self.scenario_live_quota_source_smoke)
        self.run_scenario("AT-002", "synthetic Codex app-server poll", self.scenario_synthetic_codex_app_server_poll)
        self.run_scenario("AT-003", "synthetic CodexBar open poll", self.scenario_synthetic_open_poll)
        self.run_scenario("AT-004", "synthetic blocked guard wait", self.scenario_synthetic_blocked_guard_wait)
        self.run_scenario("AT-005", "daemon lifecycle", self.scenario_daemon_lifecycle)
        self.run_scenario("AT-006", "hook installer temp merge", self.scenario_hook_installer_temp_merge)
        self.run_scenario("AT-007", "global hook config", self.scenario_global_hook_config)
        self.run_scenario("AT-008", "CodexBar failure fails open", self.scenario_codexbar_failure_fails_open)
        self.run_scenario("AT-009", "state-only guard avoids live source", self.scenario_state_only_guard_avoids_live_source)
        self.run_scenario("AT-010", "prompt guard avoids live source", self.scenario_prompt_guard_avoids_live_source)
        self.run_scenario(
            "AT-011",
            "auto source never downgrades authority",
            self.scenario_auto_source_never_downgrades_authority,
        )
        self.run_scenario("AT-012", "weekly advisory opt-out", self.scenario_weekly_advisory_opt_out)
        self.run_scenario("AT-013", "weekly-only default hard-block", self.scenario_weekly_only_positional_safety)
        self.run_scenario("AT-014", "auxiliary bucket remains advisory", self.scenario_auxiliary_bucket_remains_advisory)
        self.run_scenario(
            "AT-015",
            "weekly prompt guard waits for authoritative reset",
            self.scenario_weekly_prompt_guard_waits_until_reset,
        )
        self.run_scenario(
            "AT-016",
            "hook safety deadline fails closed",
            self.scenario_hook_safety_deadline_fails_closed,
        )
        self.run_scenario(
            "AT-017",
            "confirmed block survives source failure",
            self.scenario_confirmed_block_survives_source_failure,
        )
        self.run_scenario(
            "AT-018",
            "valid block wins over malformed sibling",
            self.scenario_valid_block_wins_over_malformed_sibling,
        )
        self.run_scenario(
            "AT-019",
            "backend exhaustion without windows blocks",
            self.scenario_backend_exhaustion_without_windows_blocks,
        )
        self.run_scenario(
            "AT-020",
            "fresh unknown state fails closed",
            self.scenario_fresh_unknown_state_fails_closed,
        )
        self.run_scenario(
            "AT-021",
            "omitted backend state cannot clear latch",
            self.scenario_omitted_backend_state_cannot_clear_latch,
        )
        self.run_scenario(
            "AT-022",
            "ambiguous replacement buckets fail closed",
            self.scenario_ambiguous_replacement_buckets_fail_closed,
        )

    def write_report(self) -> Path:
        report_path = self.run_dir / "report.md"
        lines = [
            "# Quota Sentry Autonomous Test Report",
            "",
            f"- Run directory: `{self.run_dir}`",
            f"- Started: `{datetime.now(timezone.utc).replace(microsecond=0).isoformat()}`",
            "",
            "## Summary",
            "",
        ]
        for result in self.results:
            lines.append(f"- {result.status}: {result.scenario_id} {result.title}")
        lines.append("")
        for result in self.results:
            lines.extend([f"## {result.scenario_id}: {result.title}", "", f"Status: **{result.status}**", ""])
            if result.notes:
                lines.append("Notes:")
                for note in result.notes:
                    lines.append(f"- {note}")
                lines.append("")
            if result.commands:
                lines.append("Commands:")
                for command in result.commands:
                    lines.append("")
                    lines.append(f"- `{' '.join(command.args)}`")
                    lines.append(f"  - exit: `{command.returncode}`")
                    lines.append(f"  - duration: `{command.duration_seconds:.2f}s`")
                    if command.stdout.strip():
                        lines.append("  - stdout:")
                        lines.append("    ```text")
                        lines.extend(f"    {line}" for line in command.stdout.strip().splitlines()[:40])
                        lines.append("    ```")
                    if command.stderr.strip():
                        lines.append("  - stderr:")
                        lines.append("    ```text")
                        lines.extend(f"    {line}" for line in command.stderr.strip().splitlines()[:40])
                        lines.append("    ```")
                lines.append("")
        report_path.write_text("\n".join(lines) + "\n")
        return report_path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run Quota Sentry autonomous E2E tests.")
    parser.add_argument("--list", action="store_true", help="List scenarios without running them.")
    parser.add_argument("--skip-live", action="store_true", help="Skip the real Codex quota source smoke scenario.")
    parser.add_argument(
        "--require-global-hook",
        action="store_true",
        help="Fail unless the active Codex home has trusted hooks from this checkout.",
    )
    parser.add_argument("--run-dir", default=None, help="Directory for test artifacts.")
    parser.add_argument("--cleanup", action="store_true", help="Remove run artifacts after a successful run.")
    return parser.parse_args()


def list_scenarios() -> None:
    for scenario_id, title in SCENARIOS:
        print(f"{scenario_id} {title}")


def main() -> int:
    args = parse_args()
    if args.list:
        list_scenarios()
        return 0

    run_dir = Path(args.run_dir).expanduser().resolve() if args.run_dir else (
        DEFAULT_RUN_ROOT / datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    )
    if run_dir.exists():
        shutil.rmtree(run_dir)
    run_dir.mkdir(parents=True)

    harness = Harness(run_dir=run_dir, skip_live=args.skip_live, require_global_hook=args.require_global_hook)
    harness.run_all()
    report_path = harness.write_report()

    failures = [result for result in harness.results if result.status == "FAIL"]
    skipped = [result for result in harness.results if result.status == "SKIP"]
    passed = [result for result in harness.results if result.status == "PASS"]

    for result in harness.results:
        print(f"{result.status}: {result.scenario_id} {result.title}")
        for note in result.notes:
            print(f"  {note}")
    print(f"Report: {report_path}")

    if failures:
        return 1
    if skipped:
        print(f"Skipped: {len(skipped)}")
    print(f"Passed: {len(passed)}")

    if args.cleanup:
        shutil.rmtree(run_dir)
        print("Artifacts cleaned up.")
    else:
        print("Artifacts kept for inspection. Remove the run directory when done.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
